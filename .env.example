# Required: supply credentials from a secret manager; never commit .env.
MONGO_URI=
MONGO_DATABASE=children_media
REDIS_URL=
OPERATOR_KEY=
REVIEWER_KEY=
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
PROVIDER_KEY=
TEXT_PROVIDER_URL=
IMAGE_PROVIDER_URL=
VIDEO_PROVIDER_URL=
VOICE_PROVIDER_URL=
# Compose database bootstrap credentials (not used directly by the app)
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
MONGO_APP_USERNAME=
MONGO_APP_PASSWORD=
REDIS_PASSWORD=
# Daily drafts; real text/video providers must be configured before scheduling starts.
DAILY_VIDEOS_ENABLED=true
DAILY_VIDEO_COUNT=20
DAILY_VIDEO_HOUR=9
DAILY_VIDEO_TIMEZONE=America/New_York
PRIMARY_MARKET=US
CONTENT_LANGUAGE=en-US
SECONDARY_MARKET=Europe
LOWER_PRIORITY_MARKET=Asia
DAILY_VIDEO_AGE_MIN=4
DAILY_VIDEO_AGE_MAX=7
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Set a supported Meta Graph API version for your approved Instagram Login app.
INSTAGRAM_API_VERSION=
INSTAGRAM_AUTO_PUBLISH=true
TELEGRAM_SALES_ENABLED=true
PRODUCT_PRICE_STARS=250
# Internal reference only; actual checkout is XTR, not USD.
REFERENCE_PRICE_USD_CENTS=500
MERCHANT_SUPPORT=
MERCHANT_TERMS_URL=
PUBLIC_DOMAIN=
TLS_EMAIL=
